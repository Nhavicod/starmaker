rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /systemSettings/{document} {
      allow read, write: if true;
    }
    match /registros_form/{document} {
      allow read, write: if true;
    }
    match /soporte_tickets/{document} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
